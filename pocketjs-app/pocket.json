{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.kkanpan.app",
  "name": "kkanpan",
  "title": "KKANPAN Stock Dashboard",
  "version": "1.0.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "input.touch"
      ],
      "enhances": []
    }
  },
  "app": {
    "entry": "src/main.tsx",
    "output": "kkanpan-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [536, 511],
        "presentation": "native"
      }
    }
  }
}
